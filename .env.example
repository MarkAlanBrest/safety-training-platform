DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/DATABASE?sslmode=require"
# Use Neon's pooled hostname (includes -pooler) for DATABASE_URL on Vercel.
# Use the direct (non-pooler) URL for Prisma CLI and npm run db:setup.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/DATABASE?sslmode=require"
# Local directory for SCORM/classroom file blobs (default: data/uploads). Used only off Vercel.
COURSE_UPLOADS_DIR=""
# Force disk (1) or Postgres blobs (1). Default: disk locally, Postgres on Vercel/Lambda.
COURSE_UPLOADS_USE_DISK=""
COURSE_UPLOADS_USE_DB=""
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Administrator"
OPENAI_API_KEY="sk-your-key"
OPENAI_MODEL="gpt-5.6-sol"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
MASON_VOICE="cedar"

# Resume intake
RESUME_PROGRAMS="Automotive Technology|Building Technology|Combination Welding|Electrical Technology|Industrial Electro-Mechanical Technology|Machinist & CNC Manufacturing|Refrigeration & A/C Technology|Commercial Truck Driving|Diesel & Heavy Equipment Repair|Heavy Equipment Operations with CDL Training|Motorcycle & Power Equipment Technology|East Liverpool, Combination Welding|East Liverpool, Electrical & Industrial Maintenance|East, Liverpool, Refrigeration & Climate Control"

# Optional folder inside the Career Services Resume System document library
SHAREPOINT_RESUME_FOLDER=""

# Canonical public HTTPS origin used for Microsoft Office Online deck URLs.
# Office must fetch decks from a stable, publicly reachable URL (not localhost or protected previews).
NEXT_PUBLIC_APP_ORIGIN="https://safety-training-platform-eight.vercel.app"

# SharePoint column internal names (defaults shown)
SP_FIELD_STUDENT_NAME="Student_x0020_Name"
SP_FIELD_ADDRESS="Address"
SP_FIELD_PROGRAM="Program"
SP_FIELD_GRADUATION_DATE="Graduation_x0020_Date"
SP_FIELD_SKILLS="Skills"
SP_FIELD_CERTIFICATIONS="Certifications"
SP_FIELD_STATUS="Status"
