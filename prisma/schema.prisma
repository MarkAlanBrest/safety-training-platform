generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model MasonCourse {
  id               Int                @id @default(autoincrement())
  title            String
  slug             String             @unique
  description      String?
  audience         String?
  theme            String             @default("heritage")
  companyName      String?
  logoData         String?            @db.Text
  accentColor      String?
  displayMode      String             @default("webpage")
  courseType       String             @default("pdf")
  scormVersion     String?
  scormEntryPoint  String?
  intensity        String             @default("standard")
  estimatedMinutes Int                @default(60)
  published        Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sections         MasonSection[]
  enrollmentCodes EnrollmentCode[]
  enrollments      CourseEnrollment[]
  scormAssets      ScormAsset[]
  classroomAttempts ClassroomAttempt[]
}

/** Slugs an admin deleted — deploy-time seed install must not recreate them. */
model SeedCourseSuppression {
  slug         String   @id
  suppressedAt DateTime @default(now())
}

model ClassroomAttempt {
  id               Int       @id @default(autoincrement())
  courseId         Int
  studentEmail     String
  studentName      String?
  attemptNumber    Int
  answers          Json
  score            Int
  passed           Boolean
  startedAt        DateTime  @default(now())
  submittedAt      DateTime?
  timeLimitMinutes Int?
  aiReviewSummary  String?   @db.Text
  certificateId    String?
  course           MasonCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, studentEmail])
}

model ScormAsset {
  id        Int         @id @default(autoincrement())
  courseId  Int
  path      String
  mimeType  String
  content   Bytes
  course    MasonCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, path])
  @@index([courseId])
}

model MasonSection {
  id               Int         @id @default(autoincrement())
  courseId         Int
  title            String
  position         Int
  estimatedMinutes Int         @default(15)
  fileName         String
  lessonPlan       Json
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  course           MasonCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
  @@index([courseId])
}

model EnrollmentCode {
  id            Int               @id @default(autoincrement())
  code          String            @unique
  courseId      Int
  batchName     String?
  recipientName String            @default("")
  company       String?           @default("")
  status        String            @default("available")
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  claimedAt     DateTime?
  course        MasonCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment    CourseEnrollment?

  @@index([courseId, status])
}

model CourseEnrollment {
  id             Int            @id @default(autoincrement())
  courseId       Int
  codeId         Int            @unique
  firstName      String
  lastName       String
  email          String
  status         String         @default("active")
  progress       Int            @default(0)
  enrolledAt     DateTime       @default(now())
  lastAccessedAt DateTime       @default(now())
  completedAt    DateTime?
  scormData      Json?
  score          Int?
  course         MasonCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code           EnrollmentCode @relation(fields: [codeId], references: [id], onDelete: Restrict)

  @@index([courseId, status])
  @@index([email])
}

/** Caches synthesized TTS audio by exact (text, voice, speed) so identical narration — the
 * course welcome message, replayed lines, repeated feedback — is served instantly instead
 * of paying to re-synthesize it every time. */
model SpeechCache {
  id        Int      @id @default(autoincrement())
  hash      String   @unique
  voice     String
  speed     Float
  mimeType  String
  audio     Bytes
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
}

model AdminUser {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  passwordHash String
  name         String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   Int
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model CourseAlertSignup {
  id             Int      @id @default(autoincrement())
  canvasCourseId String
  canvasUserId   String
  courseName     String?
  studentName    String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([canvasCourseId, canvasUserId])
  @@index([canvasCourseId])
}

model CourseAlertMessage {
  id             Int       @id @default(autoincrement())
  canvasCourseId String
  canvasUserId   String
  studentName    String
  message        String    @db.Text
  active         Boolean   @default(true)
  createdBy      String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?

  @@index([canvasCourseId, canvasUserId, active])
}

model CourseAlertConfig {
  canvasCourseId             String   @id
  courseName                 String?
  missingWorkDays            Int      @default(14)
  lowGradeThreshold          Int      @default(70)
  assignmentLowGradePercent  Int      @default(60)
  loginInactivityDays        Int      @default(6)
  dueSoonHours               Int      @default(6)
  bannerMessage              String?  @db.Text
  missingMessage             String?  @db.Text
  assignmentLowGradeMessage  String?  @db.Text
  loginInactivityMessage     String?  @db.Text
  overallLowGradeMessage     String?  @db.Text
  dueSoonMessage             String?  @db.Text
  showMissing                Boolean  @default(true)
  showLowGrades              Boolean  @default(true)
  showAssignmentLowGrades    Boolean  @default(true)
  showLoginInactivity        Boolean  @default(true)
  showDueSoon                Boolean  @default(true)
  showMissingEmail           Boolean  @default(false)
  missingEmailSubject        String?  @db.Text
  missingEmailBody           String?  @db.Text
  showAssignmentLowGradesEmail Boolean @default(false)
  assignmentLowGradeEmailSubject String? @db.Text
  assignmentLowGradeEmailBody    String? @db.Text
  showLowGradesEmail         Boolean  @default(false)
  lowGradesEmailSubject      String?  @db.Text
  lowGradesEmailBody         String?  @db.Text
  showLoginInactivityEmail   Boolean  @default(false)
  loginInactivityEmailSubject String? @db.Text
  loginInactivityEmailBody   String?  @db.Text
  showDueSoonEmail           Boolean  @default(false)
  dueSoonEmailSubject        String?  @db.Text
  dueSoonEmailBody           String?  @db.Text
  emailFrequencyDays         Int      @default(1)
  lastEmailSentAt            DateTime?
  homeEmbedEnabled           Boolean  @default(false)
  updatedBy                  String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}
