generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model CourseRecords {
  id         Int       @id @default(autoincrement())
  FirstName  String
  LastName   String
  Email      String
  CourseName String
  Code       String    @unique
  StartDate  DateTime
  EndDate    DateTime?
  Test1      Int
  Test2      Int
  Test3      Int
  Test4      Int
  Test5      Int
  Test6      Int
  Test7      Int
  Test8      Int
  Progress   Int
  SlidesPath String?
}

model MasonCourse {
  id               Int                @id @default(autoincrement())
  title            String
  slug             String             @unique
  description      String?
  audience         String?
  theme            String             @default("heritage")
  companyName      String?
  logoData         String?            @db.Text
  accentColor      String?
  displayMode      String             @default("webpage")
  courseType       String             @default("pdf")
  scormVersion     String?
  scormEntryPoint  String?
  intensity        String             @default("standard")
  estimatedMinutes Int                @default(60)
  published        Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sections         MasonSection[]
  enrollmentCodes EnrollmentCode[]
  enrollments      CourseEnrollment[]
  scormAssets      ScormAsset[]
  classroomAttempts ClassroomAttempt[]
}

model ClassroomAttempt {
  id               Int       @id @default(autoincrement())
  courseId         Int
  studentEmail     String
  studentName      String?
  attemptNumber    Int
  answers          Json
  score            Int
  passed           Boolean
  startedAt        DateTime  @default(now())
  submittedAt      DateTime?
  timeLimitMinutes Int?
  aiReviewSummary  String?   @db.Text
  certificateId    String?
  course           MasonCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, studentEmail])
}

model ScormAsset {
  id        Int         @id @default(autoincrement())
  courseId  Int
  path      String
  mimeType  String
  content   Bytes
  course    MasonCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, path])
  @@index([courseId])
}

model MasonSection {
  id               Int         @id @default(autoincrement())
  courseId         Int
  title            String
  position         Int
  estimatedMinutes Int         @default(15)
  fileName         String
  lessonPlan       Json
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  course           MasonCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
  @@index([courseId])
}

model EnrollmentCode {
  id            Int               @id @default(autoincrement())
  code          String            @unique
  courseId      Int
  batchName     String?
  recipientName String            @default("")
  company       String?           @default("")
  status        String            @default("available")
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  claimedAt     DateTime?
  course        MasonCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment    CourseEnrollment?

  @@index([courseId, status])
}

model CourseEnrollment {
  id             Int            @id @default(autoincrement())
  courseId       Int
  codeId         Int            @unique
  firstName      String
  lastName       String
  email          String
  status         String         @default("active")
  progress       Int            @default(0)
  enrolledAt     DateTime       @default(now())
  lastAccessedAt DateTime       @default(now())
  completedAt    DateTime?
  scormData      Json?
  score          Int?
  course         MasonCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code           EnrollmentCode @relation(fields: [codeId], references: [id], onDelete: Restrict)

  @@index([courseId, status])
  @@index([email])
}

model AdminUser {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  passwordHash String
  name         String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   Int
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}
